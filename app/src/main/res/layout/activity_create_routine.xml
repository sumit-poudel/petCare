<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/create_routine_title"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="@color/primary"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/create_routine_subtitle"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_white"
            android:padding="18dp">

            <EditText
                android:id="@+id/titleInput"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="@string/routine_title_hint"/>

            <EditText
                android:id="@+id/descriptionInput"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:hint="@string/description_hint"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:layout_marginTop="10dp"/>

            <EditText
                android:id="@+id/dateInput"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="@string/select_date_hint"
                android:focusable="false"
                android:clickable="true"
                android:layout_marginTop="10dp"/>

            <EditText
                android:id="@+id/timeInput"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="@string/select_time_hint"
                android:focusable="false"
                android:clickable="true"
                android:layout_marginTop="10dp"/>

            <Button
                android:id="@+id/saveRoutineButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="@string/save_routine_button"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="@color/primary"
                android:layout_marginTop="20dp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>