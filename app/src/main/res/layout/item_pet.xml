<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/card_white"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <FrameLayout
    android:id="@+id/petPhotoContainer"
    android:layout_width="56dp"
    android:layout_height="56dp">

        <TextView
            android:id="@+id/petPhotoPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/circle_lavender"
            android:gravity="center"
            android:text="🐾"
            android:textSize="24sp"/>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/petPhoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/CircleImageStyle"/>

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp">

        <TextView
            android:id="@+id/petName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/default_pet_name"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="@color/primary"/>

        <TextView
            android:id="@+id/petDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/default_pet_type_breed"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:layout_marginTop="5dp"/>

        <TextView
            android:id="@+id/petInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pet_info_format"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="5dp"/>

    </LinearLayout>

</LinearLayout>